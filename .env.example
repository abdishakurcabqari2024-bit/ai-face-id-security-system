# ============================================================
# AI FACE ID SECURITY SYSTEM - ENVIRONMENT CONFIGURATION
# ============================================================

# 1. External Database (Hosted PostgreSQL - Neon, Supabase, or Railway)
# Example: postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/face_security_db?sslmode=require
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/face_security_db"

# 2. Python Biometric Recognition Microservice URL (Render, Railway, or Local)
# When running locally: http://localhost:8000
# When deployed to Render: https://face-id-recognition-engine.onrender.com
RECOGNITION_SERVICE_URL="http://localhost:8000"

# 3. Recognition Service API Secret (Shared secret between Next.js and Python microservice)
RECOGNITION_SECRET_KEY="replace_with_a_secure_random_hex_string_32_bytes"

# 4. Security Operator / Admin Master Key (Required for user enrollment and profile deletion)
ADMIN_API_KEY="replace_with_secure_admin_api_key_for_management"

# 5. Security & Verification Parameters
DEFAULT_SECURITY_THRESHOLD="0.75"
RATE_LIMIT_MAX_REQUESTS="20"
RATE_LIMIT_WINDOW_SECONDS="60"
REQUIRE_LIVENESS="true"
